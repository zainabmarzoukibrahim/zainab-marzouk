            <!--right image-->
            <div class="banner-side-image" >
        </div>
    </div>
    </div>

<!--bottom bar-->
<div class="bottom=bar">
    <p>
        SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
    </p>
    </div>
</section>
