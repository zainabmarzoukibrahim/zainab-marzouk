
{{ 'custom-banner.css' | asset_url | stylesheet_tag }}

<div class="custom-banner">
  
  <!-- Top Bar -->
  <div class="top-bar">
    <div class="top-left">
      <button class="mobile-menu-btn mobile-onlu" aria-label="Menu">
        <span></span><span></span><span></span></button>
      <span class="banner-logo">{{ section.settings.logo_text }}</span>
    </div>
    <div class="top-center">
      <div class="banner-logo mobile-only">{{ section.settings.logo_text }}</div>
      <p>{{ section.settings.top_text }}</p>
    </div>
    <div class="top-right">
      <a href="{{ section.settings.top_button_link }}" class="btn-choose">
        {{ section.settings.top_button_text }} →
      </a>
    </div>
  </div>
  

  <!-- Banner Container -->
  <div class="banner-container">
    
    <!-- Mobile: Title & Description  -->
<div class="mobile-banner-header mobile-only">
  <h1>{{ section.settings.title }}</h1>
  <p>{{ section.settings.mobile_description }}</p>
</div>

<!-- Banner Image -->
<div class="banner-image"
  {% if section.settings.background_image != blank %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');"
  {% endif %}
>
  <!-- Mobile: SHOP NOW button  -->
  <div class="mobile-banner-cta mobile-only">
    <a href="{{ section.settings.button_link }}" class="shop-btn">
      {{ section.settings.button_text }} →
    </a>
  </div>
</div>

<!-- Mobile: Sustainable text -->
<div class="mobile-footer-bar mobile-only">
  {{ section.settings.mobile_footer_text }}
</div>

<!-- Desktop Only: Bottom Content -->
<div class="banner-bottom desktop-only">
  <div class="banner-text">
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.description }}</p>
    <a href="{{ section.settings.button_link }}" class="shop-btn">
      {{ section.settings.button_text }} →
    </a>
  </div>

  <div class="banner-side-image desktop-only"
    {% if section.settings.side_image != blank %}
      style="background-image: url('{{ section.settings.side_image | image_url: width: 800 }}');"
    {% endif %}
  ></div>
</div>

<!-- Desktop Only: Footer -->
<div class="banner-footer desktop-only">
  {{ section.settings.footer_text }}
</div>
    
  </div>
  
  <p class="banner-footer mobile-only">{{ section.settings.footer_text }}</p>
</div>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Top Background Image"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Side Image (Right)"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_text",
      "label": "Top Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top Button Link"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
"type": "textarea",
"id": "mobile_description",
"label": "mobiledescription",
"default": "Discover Joy: Your Ultimate Holiday Gift Destination."
},
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "SUSTAINABLE, ETHICALLY-MADE CLOTHES IN SIZES XS TO 6XL"
    },
    {
"type": "text",
"id": "mobile_footer_text",
"label": "Mobile Footer Text",
"default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
}
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}
