{{ 'custom-banner.css' | asset_url | stylesheet_tag }}
<section class ="custom-banner">
    <!--top bar-->
<div class="top-bar">
 <div class="top-left">
     <!--text-->
   </div>
   <div class="top-center">
     <!--text-->
    </div>
    <div class="top-right">
        <a href="#"class="choose-gift-btn">
            Choose Gift<span class ="arrow">-></span>
        </a>
      
        </div>
    </div>
