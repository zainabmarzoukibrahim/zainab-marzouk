{{ 'custom-grid.css' | asset_url | stylesheet_tag }}
<section class="custom-grid">
  <p class="grid-tagline">Tisso vison in the wild</p>
    <div class="grid-container">
     {% for block in section.blocks %}
        {% assign  product = block.settings.product %}
        {% if product != blank  %}
            <div class="grid-item grid-item--{{ forloop.index }}" {{ block.shopify_attributes }}>
                <div class="grid-image-wrapper">
                    <img
                        src="{{ product.featured_image | image_url: width: 919 }}"
                        alt="{{ product.title | escape }}"
                        class="grid-image"
                        loading="lazy"
                          width="919"
                        height="943"
                     >
                 

                        <button
                        type="button"
                        class="grid-popup-btn grid-popup-btn--{{ forloop.index }}"
                        data-product-handle="{{ product.handle }}" 
                    aria-label="view{{ product.title | escape }}" >
                        <span> + </span>
                    </button>
                </div>
     </div>
    
    {% endif %}
{% endfor %}
</div>


</section>

<div id="productPopup" class="product-popup">
  <div class="popup-overlay"></div>

  <div class="popup-modal">

    <button
      type="button"
      class="popup-close"
      aria-label="Close popup">x
    </button>

    <div class="product-popup-content">

      <div class="popup-top">

        <div class="popup-image-wrapper">
      
<img
  id="popupImg"
  src=""
  alt=""
  width="600"
  height="600"
  loading="lazy">


        </div>

        <div class="popup-info">

          <h2 id="popupTitle"></h2>

          <div id="popupPrice" class="popup-price"></div>

          <div id="popupDesc" class="popup-description"></div>

        </div>

      </div>

      <div id="popupVariants" class="popup-variants"></div>

      <div
        id="popupError"
        class="popup-error"
        style="display:none;">
      </div>

      <button
        type="button"
        id="popupAddBtn"
        class="popup-add-btn"
        disabled>
        <span>ADD TO CART</span>
        <span class="popup-arrow">→</span>
      </button>

    </div>
  </div>
</div>

<script src="{{ 'custom-grid.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Gift Guide Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,

  "blocks": [
    {
      "type": "product",
      "name": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Gift Guide Grid",
      "blocks": {
        "product-1": {
          "type": "product"
        },
        "product-2": {
          "type": "product"
        },
        "product-3": {
          "type": "product"
        },
        "product-4": {
          "type": "product"
        },
        "product-5": {
          "type": "product"
        },
        "product-6": {
          "type": "product"
        }
      },
      "block_order": [
        "product-1",
        "product-2",
        "product-3",
        "product-4",
        "product-5",
        "product-6"
      ]
    }
  ]
}
{% endschema %}